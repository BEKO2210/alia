def build_qwen_command(extra_args: list[str], qwen: str | None = None) -> list[str]:
    executable = qwen or shutil.which("qwen") or str(Path.home() / ".npm-global/bin/qwen")
    return [executable, *extra_args]


def build_web_command(
    port: int = WEB_PORT, open_browser: bool = True,
    workspace: Path | None = None, qwen: str | None = None,
) -> list[str]:
    command = build_qwen_command(
        ["serve", "--hostname", HOST, "--port", str(port)], qwen=qwen
    )
    if open_browser:
        command.append("--open")
    if workspace is not None:
        command.extend(["--workspace", str(workspace)])
    return command


def qwen_environment(paths: dict[str, Path]) -> dict[str, str]:
    env = os.environ.copy()
    env.update({
        "QWEN_HOME": str(paths["qwen_home"]),
        "QWEN_RUNTIME_DIR": str(paths["qwen_home"] / "runtime"),
        "ALIA_LOCAL_API_KEY": API_KEY,
        "QWEN_CODE_MODELS_DEV": "off",
        "QWEN_CODE_LANG": _LANGUAGE,
        "QWEN_USAGE_STATISTICS_ENABLED": "false",
        "QWEN_TELEMETRY_ENABLED": "false",
        # Deep-context prompt evaluation and thinking can exceed the default 15 minutes.
        "QWEN_STREAM_MAX_LIFETIME_MS": "1800000",
        # Keep optional title and tool-summary side requests off if a fast model is configured.
        "QWEN_DISABLE_AUTO_TITLE": "1",
        "QWEN_CODE_EMIT_TOOL_USE_SUMMARIES": "0",
    })
    shim_dir = paths["qwen_home"] / "bin"
    if (shim_dir / "python").is_symlink():
        env["PATH"] = f"{shim_dir}{os.pathsep}{env.get('PATH', '')}"
    return env


def run_qwen(command: list[str], paths: dict[str, Path]) -> int:
    if not Path(command[0]).exists() and shutil.which(command[0]) is None:
        raise RuntimeError(tr("error.qwen_missing"))
    return subprocess.run(command, env=qwen_environment(paths), check=False).returncode


def launch_qwen(paths: dict[str, Path], extra: list[str]) -> int:
    return run_qwen(build_qwen_command(extra), paths)


def display_width(text: str) -> int:
    """Approximate terminal cells using Unicode East Asian Width."""
    return sum(2 if unicodedata.east_asian_width(char) in {"W", "F"} else 1 for char in text)


def validate_banner_logo(path: Path) -> tuple[bool, str]:
    """Validate a text logo against Qwen's file, row, and column caps."""
    try:
        size = path.stat().st_size
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as exc:
        return False, tr("validation.unreadable_utf8", error=exc)
    if size > MAX_BANNER_BYTES:
        return False, tr("validation.bytes_exceeded", actual=size, maximum=MAX_BANNER_BYTES)
    lines = text.replace("\r\n", "\n").replace("\r", "\n").split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    if len(lines) > MAX_BANNER_LINES:
        return False, tr("validation.lines_exceeded", actual=len(lines), maximum=MAX_BANNER_LINES)
    for number, line in enumerate(lines, 1):
        width = display_width(line.replace("\t", "  ").rstrip())
        if width > MAX_BANNER_COLUMNS:
            return False, tr(
                "validation.line_too_wide", line=number, actual=width,
                maximum=MAX_BANNER_COLUMNS,
            )
    return (bool(lines), tr("validation.ok") if lines else tr("validation.empty"))


def validate_svg_logo(path: Path) -> tuple[bool, str]:
    """Check the stable, externally observable Web Shell logo constraints."""
    try:
        metadata = path.lstat()
        if stat.S_ISLNK(metadata.st_mode):
            return False, tr("validation.symlink")
        if not stat.S_ISREG(metadata.st_mode):
            return False, tr("validation.not_regular")
        if metadata.st_nlink != 1:
            return False, tr("validation.hardlinks", count=metadata.st_nlink)
        data = path.read_bytes()
    except OSError as exc:
        return False, tr("validation.unreadable", error=exc)
    if len(data) > MAX_BRAND_LOGO_BYTES:
        return False, tr("validation.bytes_exceeded", actual=len(data), maximum=MAX_BRAND_LOGO_BYTES)
    try:
        text = data.decode("utf-8")
        root = ET.fromstring(text)
    except (UnicodeError, ET.ParseError) as exc:
        return False, tr("validation.invalid_svg", error=exc)
    if root.tag != "{http://www.w3.org/2000/svg}svg":
        return False, tr("validation.svg_root")
    view_box = root.attrib.get("viewBox", "").strip()
    if not view_box and not (root.attrib.get("width", "").strip() and root.attrib.get("height", "").strip()):
        return True, tr("validation.svg_geometry")
    return True, tr("validation.ok")


def format_table(headers: list[str], rows: list[list[str]]) -> str:
    widths = [len(header) for header in headers]
    for row in rows:
        for index, cell in enumerate(row):
            widths[index] = max(widths[index], len(cell))
    def render(row: list[str]) -> str:
        return "  ".join(cell.ljust(widths[index]) for index, cell in enumerate(row)).rstrip()

    return "\n".join([render(headers), render(["─" * width for width in widths]), *(render(row) for row in rows)])


def short_gpu_name(name: str | None) -> str:
    """'NVIDIA GeForce RTX 3070' -> 'RTX 3070' so the banner subtitle fits on one line."""
    if not name:
        return "CPU"
    return re.sub(r"^(NVIDIA\s+)?(GeForce\s+)?", "", name).strip() or name


def profile_title(profile: dict[str, Any], language: str | None = None) -> str:
    if not profile.get("title_key"):
        return profile["title"]
    return tr_for(language, profile["title_key"]) if language else tr(profile["title_key"])


def cmd_profiles(profiles: list[dict[str, Any]], hw: dict[str, Any], selected: str | None) -> int:
    rows = []
    for item in sorted(profiles, key=lambda value: value.get("rank", 0), reverse=True):
        mark = "●" if item["id"] == selected else ("✓" if profile_fits(item, hw) else " ")
        measured = item.get("measured")
        if measured:
            def metrics(prefix: str, measured: dict[str, Any] = measured) -> str:
                values = []
                base = measured.get(f"{prefix}_tps")
                if isinstance(base, (int, float)):
                    context = measured.get(f"{prefix}_context")
                    values.append(f"{base:g}" + (f" @{context}" if context else ""))
                for context in ("4k", "32k", "60k"):
                    value = measured.get(f"{prefix}_tps_{context}")
                    if isinstance(value, (int, float)):
                        values.append(f"{context.upper()} {value:g}")
                return " / ".join(values) + (" " + tr("profiles.unit_tps") if values else "—")

            speed = metrics("tg")
            pp = metrics("pp")
            quality_parts = []
            for key, label in (("code_pass", "profiles.quality.code"), ("tool_pass", "profiles.quality.tools"), ("json_pass", "profiles.quality.json")):
                if key in measured:
                    quality_parts.append(f"{tr(label)} {measured[key]}")
            quality = " · ".join(quality_parts) or "—"
            source = str(measured.get("source", "—"))
            if item.get("flags_pending_final"):
                source += " · " + tr("profiles.pending_flags")
        else:
            note = tr(item["note_key"]) if item.get("note_key") else item.get("note", "—")
            speed, pp, quality, source = tr("profiles.unmeasured"), "—", "—", note
        rows.append([mark, item["id"], speed, pp, quality, source])
    print(format_table([
        "", tr("profiles.header.profile"), tr("profiles.header.tg"), tr("profiles.header.pp"),
        tr("profiles.header.quality"), tr("profiles.header.source"),
    ], rows))
    print("\n" + tr("profiles.legend"))
    return 0


def _version(command: list[str], env: dict[str, str] | None = None) -> str:
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=5, check=False, env=env)
        return (result.stdout or result.stderr).strip().splitlines()[0]
    except (OSError, subprocess.TimeoutExpired, IndexError):
        return tr("version.not_found")


def qwen_version_supported(output: str) -> bool:
    return any(
        match.group(1) == "0.25.1"
        for match in re.finditer(r"(?<![\d.])v?(\d+\.\d+\.\d+)(?![\w.-])", output)
    )


def qwen_compaction_thresholds(window: int) -> tuple[int, int]:
    """Auto-compact and hard-stop token counts of Qwen Code 0.25.1 for a context window.

    Mirrors computeThresholds() with its defaults: 20,000 tokens stay reserved for the
    summary, auto-compaction starts at min(85 %, window - 33,000) and requests stop at the
    hard limit. Windows slightly above 33K therefore compact almost immediately.
    """
    effective = max(0, window - 20000)
    proportional = 0.85 * window
    ceiling = effective - 13000
    auto = min(proportional, ceiling) if ceiling > 0 else proportional
    hard = min(window, max(effective - 3000, auto + 3000))
    return int(auto), int(hard)


def compaction_too_early(window: int) -> bool:
    return qwen_compaction_thresholds(window)[0] < window * 0.4


def compaction_summary(window: int) -> str:
    auto, hard = qwen_compaction_thresholds(window)
    return tr("doctor.compaction", auto=auto, hard=hard) + (" ⚠" if compaction_too_early(window) else "")


def compaction_warning(window: int) -> str | None:
    if not compaction_too_early(window):
        return None
    auto, hard = qwen_compaction_thresholds(window)
    return tr("startup.compaction_warning", ctx=window, auto=auto, hard=hard)


def port_open(host: str = HOST, port: int = PORT) -> bool:
    try:
        with socket.create_connection((host, port), timeout=0.3):
            return True
    except OSError:
        return False


def doctor_ollama_status() -> str:
    models = ollama_loaded_models()
    if models is None:
        return tr("doctor.ollama_off")
    names = [item.get("name") or item.get("model") for item in models]
    names = [name for name in names if name]
    return tr("doctor.ollama_loaded", models=", ".join(names)) if names else tr("doctor.ollama_idle")


def cmd_doctor(profiles: list[dict[str, Any]], hw: dict[str, Any], paths: dict[str, Path]) -> int:
    config = read_config(paths["config"])
    profile, reason, warning = choose_profile(profiles, hw, config.get("profile"))
    pid = managed_pid(paths)
    state = read_server_state(paths) if pid else {}
    llama, llama_env = find_llama_server()
    # Same library path as start_server, or a binary next to its shared libraries reads "not found".
    llama_version = _version([str(llama), "--version"], {**os.environ, **llama_env}) if llama else None
    qwen = shutil.which("qwen") or str(Path.home() / ".npm-global/bin/qwen")
    qwen_version = _version([qwen, "--version"])
    model = find_model(profile, paths) if profile else None
    hf = shutil.which("hf")
    python3 = shutil.which("python3") or tr("version.not_found")
    python = shutil.which("python")
    python_text = f'{python3} · {tr("doctor.python_found", path=python) if python else tr("doctor.python_missing")}'
    foreign_port = port_open() and not (pid and process_owns_listen_port(pid, PORT))
    disk_free = shutil.disk_usage(Path.home()).free / 1_000_000_000
    gpu_index = hw.get("gpu_index")
    gpu_text = f"{hw['gpu_name']} · {hw['vram_gb']:.1f} GB"
    if gpu_index is not None:
        gpu_text += f" · index {gpu_index}"
    ram_text = f"{hw['ram_gb']:.1f} GB"
    available = mem_available_gb()
    if available is not None:
        ram_text += f" · {tr('doctor.ram_available', available=f'{available:.1f}')}"
        if profile and ram_warning(profile, available):
            ram_text += " ⚠"
    rows = [
        [tr("doctor.label.gpu"), gpu_text if hw["gpu_name"] else tr("doctor.no_gpu")],
        [tr("doctor.label.ram"), ram_text],
        ["Ollama", doctor_ollama_status()],
        [tr("doctor.label.cpu"), f"{hw['cpu_name']} · {hw['cpu_count']} {tr('doctor.threads')}"],
        [tr("doctor.label.python"), python_text],
        [tr("doctor.label.profile"), profile["id"] if profile else tr("doctor.none")],
        [tr("doctor.label.selection"), reason + (" ⚠" if warning else "")],
        [tr("doctor.label.server"), f"PID {pid} · {tr('doctor.healthy') if health_ok() else tr('doctor.not_ready')} · Port {state.get('port', PORT)}" if pid else tr("doctor.stopped")],
        [tr("doctor.label.model"), str(model) if model else tr("doctor.model_missing")],
        [tr("doctor.label.compaction"), compaction_summary(profile["ctx"]) if profile else tr("doctor.none")],
        ["Qwen", f"{qwen_version} · {qwen}" + (f" · {tr('doctor.qwen_version_warning', expected='0.25.1')}" if qwen_version != tr("version.not_found") and not qwen_version_supported(qwen_version) else "")],
        ["llama-server", f"{llama} · {llama_version}" if llama else tr("version.not_found")],
        ["hf", hf or tr("version.not_found")],
        [tr("doctor.label.port"), tr("doctor.port_foreign") if foreign_port else tr("doctor.port_available")],
        [tr("doctor.label.disk"), f"{disk_free:.1f} GB"],
        [tr("doctor.label.profiles"), str(PROFILES_FILE)],
        [tr("doctor.label.config"), str(paths["config"])],
        [tr("doctor.label.qwen_home"), str(paths["qwen_home"])],
        [tr("doctor.label.models"), str(paths["models"])],
        [tr("doctor.label.log"), str(paths["log"])],
    ]
    print(color("1;36", tr("doctor.title")))
    width = max(len(row[0]) for row in rows)
    for label, value in rows:
        print(f"{color('36', label.ljust(width))}  {value}")
    download_ready = bool(model or (hf and profile and disk_free >= profile["model"]["size_gb"] * 1.1))
    return 0 if profile and llama and qwen_version != tr("version.not_found") and download_ready and not foreign_port else 1


def cmd_logs(paths: dict[str, Path]) -> int:
    log = paths["log"]
    if not log.exists():
        print(tr("logs.none", path=log))
        return 1
    try:
        return subprocess.run(["tail", "-n", "80", "-f", str(log)], check=False).returncode
    except KeyboardInterrupt:
        return 130


def cmd_status(paths: dict[str, Path]) -> int:
    pid = managed_pid(paths)
    if pid is None:
        print(tr("status.stopped"))
        return 3
    state = read_server_state(paths)
    # Another process could answer /health on the port while the managed PID is still alive.
    ready = health_ok() and process_owns_listen_port(pid, PORT)
    started = state.get("started_at")
    uptime = max(0, int(time.time() - started)) if isinstance(started, (int, float)) else 0
    print(tr(
        "status.running", pid=pid, profile=state.get("profile", tr("doctor.none")),
        port=state.get("port", PORT), health=tr("status.ready" if ready else "status.loading"),
        uptime=uptime, model=state.get("model") or Path(str(state.get("model_path", ""))).name,
    ))
    return 0 if ready else 1


def prepare_runtime(
    profiles: list[dict[str, Any]], hw: dict[str, Any], paths: dict[str, Path],
    approval_mode: str = "default", fast: bool = False, wait_gpu: float = 0,
) -> dict[str, Any] | None:
    config = read_config(paths["config"])
    profile, reason, warning = choose_profile(profiles, hw, config.get("profile"))
    gpu = f"{hw['gpu_name']} ({hw['vram_gb']:.1f} GB)" if hw["gpu_name"] else tr("startup.no_gpu")
    print(f"{color('32', '✓')} {tr('startup.hardware', gpu=gpu, ram=hw['ram_gb'])}")
    if profile is None:
        raise RuntimeError(reason)
    print(f"{color('32', '✓')} {tr('startup.profile', profile=profile['id'], reason=reason)}")
    if warning:
        print(color("33", tr("startup.profile_warning")))
    if profile.get("flags_pending_final"):
        print(color("33", tr("startup.flags_warning")))
    compaction_note = compaction_warning(profile["ctx"])
    if compaction_note:
        print(color("33", compaction_note))
    model_path = ensure_model(profile, paths)
    if model_path is None:
        print(tr("startup.cancelled"))
        return None
    print(f"{color('32', '✓')} {tr('startup.model', path=model_path)}")
    lock_path = resolve_gpu_lock(config)
    ensure_private_dir(paths["state"])
    # The state lock is mandatory and spans reuse checks, state writes, and
    # readiness. The optional external lock coordinates unrelated GPU jobs.
    with GpuStartLock(paths["start_lock"], max(300.0, wait_gpu)):
        with GpuStartLock(lock_path, wait_gpu):
            pid, reused, process = start_server(profile, model_path, paths, hw.get("gpu_index"))
            if reused:
                print(f"{color('32', '✓')} {tr('startup.server_reused', pid=pid)}")
            else:
                wait_for_health(pid, paths, process=process, profile_id=profile["id"])
    generate_settings(
        profile, hw, paths["qwen_home"], approval_mode=approval_mode,
        language=_LANGUAGE, fast=fast,
    )
    return profile


def warn_approval_mode(approval_mode: str) -> None:
    if approval_mode == "yolo":
        print(color(
            "1;31",
            tr("warning.yolo"),
            stream=sys.stderr,
        ), file=sys.stderr)


def parse_start_args(args: list[str]) -> tuple[str, list[str], bool, float]:
    args = list(args)
    approval_mode = "default"
    fast = False
    wait_gpu = 0.0
    session_args: list[str] = []
    before, extra = args, []
    if "--" in args:
        split = args.index("--")
        before, extra = args[:split], args[split + 1:]
    index = 0
    while index < len(before):
        option = before[index]
        if option in {"--auto-edit", "--yolo"}:
            requested = option[2:]
            if approval_mode != "default" and approval_mode != requested:
                raise RuntimeError(tr("args.modes_exclusive"))
            approval_mode = requested
        elif option == "--fast":
            fast = True
        elif option in {"-c", "--continue"}:
            session_args.append("--continue")
        elif option in {"-r", "--resume"}:
            session_args.append("--resume")
            if index + 1 < len(before) and not before[index + 1].startswith("-"):
                index += 1
                session_args.append(before[index])
        elif option == "--wait-gpu":
            if index + 1 >= len(before):
                raise RuntimeError(tr("args.wait_gpu_number"))
            index += 1
            wait_gpu = parse_wait_gpu(before[index])
        else:
            raise RuntimeError(tr("args.qwen_after_separator"))
        index += 1
    if any(item in {"--auto-edit", "--yolo"} for item in extra):
        raise RuntimeError(tr("args.alia_before_separator"))
    return approval_mode, session_args + extra, fast, wait_gpu


def parse_wait_gpu(value: str) -> float:
    try:
        seconds = float(value)
    except ValueError as exc:
        raise RuntimeError(tr("args.wait_gpu_number")) from exc
    if not math.isfinite(seconds) or seconds < 0:
        raise RuntimeError(tr("args.wait_gpu_nonnegative"))
    return seconds


def cmd_start(
    extra: list[str], profiles: list[dict[str, Any]], hw: dict[str, Any],
    paths: dict[str, Path], approval_mode: str = "default", fast: bool = False,
    wait_gpu: float = 0,
) -> int:
    warn_approval_mode(approval_mode)
    profile = prepare_runtime(profiles, hw, paths, approval_mode, fast, wait_gpu)
    if profile is None:
        return 1
    return launch_qwen(paths, extra)


def parse_web_args(args: list[str]) -> tuple[int, bool, Path | None, str, bool, float]:
    port = WEB_PORT
    open_browser = True
    workspace: Path | None = None
    approval_mode = "default"
    fast = False
    wait_gpu = 0.0
    index = 0
    while index < len(args):
        option = args[index]
        if option == "--no-open":
            open_browser = False
            index += 1
            continue
        if option in {"--auto-edit", "--yolo"}:
            requested = option[2:]
            if approval_mode != "default" and approval_mode != requested:
                raise RuntimeError(tr("args.modes_exclusive"))
            approval_mode = requested
            index += 1
            continue
        if option == "--fast":
            fast = True
            index += 1
            continue
        if option not in {"--port", "--workspace", "--wait-gpu"} or index + 1 >= len(args):
            raise RuntimeError(tr("args.web_usage"))
        value = args[index + 1]
        if option == "--port":
            try:
                port = int(value)
            except ValueError as exc:
                raise RuntimeError(tr("args.port_integer")) from exc
            if not 1 <= port <= 65535:
                raise RuntimeError(tr("args.port_range"))
            if port == PORT:
                raise RuntimeError(tr("args.port_reserved", port=PORT))
        elif option == "--workspace":
            workspace = Path(value).expanduser().resolve()
            if not workspace.is_dir():
                raise RuntimeError(tr("args.workspace_directory", path=workspace))
        else:
            wait_gpu = parse_wait_gpu(value)
        index += 2
    return port, open_browser, workspace, approval_mode, fast, wait_gpu


def cmd_web(
    args: list[str], profiles: list[dict[str, Any]], hw: dict[str, Any], paths: dict[str, Path]
) -> int:
    port, open_browser, workspace, approval_mode, fast, wait_gpu = parse_web_args(args)
    warn_approval_mode(approval_mode)
    if prepare_runtime(profiles, hw, paths, approval_mode, fast, wait_gpu) is None:
        return 1
    url = f"http://{HOST}:{port}/"
    print(f"{color('1;36', tr('web.title'))}  {url}")
    return run_qwen(build_web_command(port, open_browser, workspace), paths)


def usage() -> None:
    print(tr("usage.text"))


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    paths = user_paths()
    try:
        language_flag, argv = extract_language_flag(argv)
        # Establish flag/env/locale language before reading the optional config,
        # so even a malformed config error is localized when possible.
        set_language(resolve_language(language_flag))
        config = read_config(paths["config"])
        set_language(resolve_language(language_flag, config=config))
        if argv in (["--version"], ["-V"]):
            print(f"alia {VERSION}")
            return 0
        if argv in (["--help"], ["-h"], ["help"]):
            usage()
            return 0
        profiles = load_profiles()
        if argv and argv[0] == "doctor":
            if len(argv) != 1:
                raise RuntimeError(tr("args.doctor_usage"))
            return cmd_doctor(profiles, detect_hardware(), paths)
        if argv and argv[0] == "status":
            if len(argv) != 1:
                raise RuntimeError(tr("args.status_usage"))
            return cmd_status(paths)
        if argv and argv[0] == "profiles":
            if len(argv) != 1:
                raise RuntimeError(tr("args.profiles_usage"))
            hw = detect_hardware()
            config = read_config(paths["config"])
            selected, _, _ = choose_profile(profiles, hw, config.get("profile"))
            return cmd_profiles(profiles, hw, selected["id"] if selected else None)
        if argv and argv[0] == "use":
            if len(argv) != 2:
                raise RuntimeError(tr("args.use_usage"))
            if argv[1] == "auto":
                write_config(paths["config"], None)
                print(tr("config.profile_auto"))
                return 0
            chosen = next((item for item in profiles if item["id"] == argv[1]), None)
            if chosen is None:
                raise RuntimeError(tr("config.profile_unknown", profile=argv[1]))
            write_config(paths["config"], argv[1])
            print(tr("config.profile_pinned", profile=argv[1]))
            if not profile_fits(chosen, detect_hardware()):
                print(color("33", tr("config.profile_pinned_warning")))
            return 0
        if argv and argv[0] == "lang":
            if len(argv) != 2:
                raise RuntimeError(tr("args.lang_usage"))
            requested = normalize_language(argv[1])
            if requested is None:
                raise RuntimeError(tr("config.lang_unknown", language=argv[1]))
            if argv[1].strip().lower() != "auto" and requested == "en" and not argv[1].lower().startswith("en"):
                raise RuntimeError(tr("config.lang_unknown", language=argv[1]))
            write_language_config(paths["config"], requested)
            if requested == "auto":
                print(tr("config.lang_auto"))
            else:
                set_language(requested)
                print(tr("config.lang_set", language=requested))
            return 0
        if argv and argv[0] == "stop":
            if len(argv) != 1:
                raise RuntimeError(tr("args.stop_usage"))
            # Take the same mandatory lock as startup so a stop can never run between
            # the state write and the PID write and orphan a starting server.
            ensure_private_dir(paths["state"])
            with GpuStartLock(paths["start_lock"], 300.0):
                return 0 if stop_server(paths) else 1
        if argv and argv[0] == "logs":
            if len(argv) != 1:
                raise RuntimeError(tr("args.logs_usage"))
            return cmd_logs(paths)
        if argv and argv[0] == "web":
            return cmd_web(argv[1:], profiles, detect_hardware(), paths)
        approval_mode, extra, fast, wait_gpu = parse_start_args(argv)
        return cmd_start(
            extra, profiles, detect_hardware(), paths, approval_mode=approval_mode,
            fast=fast, wait_gpu=wait_gpu,
        )
    except (RuntimeError, ValueError, OSError) as exc:
        print(color("31", tr("error.prefix", error=exc)), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\n" + tr("error.cancelled"), file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())

        # the hybrid-thinking switch from the server-side chat template kwargs.
        generation_config["extra_body"] = {
            "chat_template_kwargs": {"enable_thinking": False},
        }
    settings = {
        "$version": 4,
        # The pinned Qwen Code needs no network update check at startup.
        "general": {"language": language, "outputLanguage": "auto", "enableAutoUpdate": False},
        "env": {"ALIA_LOCAL_API_KEY": API_KEY},

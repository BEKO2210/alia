        # Background memory extraction is an extra model call per session on the single server slot.
        "memory": {"enableManagedAutoMemory": False, "enableManagedAutoDream": False},
        # Qwen Code's heuristic loop detector stays off (its default): it halted a correct vat run
        # after 18 s as "repetitive_thoughts", because thinking models restate their plan.
        "model": {
            "name": profile["id"], "baseUrl": f"http://{HOST}:{PORT}/v1",
            "skipLoopDetection": True,

def load_messages(language: str, i18n_dir: Path = I18N_DIR) -> dict[str, str]:
    path = i18n_dir / f"{language}.json"
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise RuntimeError(f"Cannot load language file {path}: {exc}") from exc
    if not isinstance(value, dict) or not all(
        isinstance(key, str) and isinstance(message, str)
        for key, message in value.items()
    ):
        raise RuntimeError(f"Language file must be a flat string map: {path}")
    return value


def available_languages(i18n_dir: Path = I18N_DIR) -> set[str]:
    return {path.stem.lower() for path in i18n_dir.glob("*.json") if path.is_file()}


def normalize_language(value: str | None, i18n_dir: Path = I18N_DIR) -> str | None:
    if not value:
        return None
    normalized = value.strip().lower().replace("_", "-").split(".", 1)[0].split("@", 1)[0]
    if normalized == "auto":
        return "auto"
    languages = available_languages(i18n_dir)
    if normalized in languages:
        return normalized
    base = normalized.split("-", 1)[0]
    return base if base in languages else "en"


def resolve_language(
    flag: str | None = None, env: dict[str, str] | None = None,
    config: dict[str, Any] | None = None, i18n_dir: Path = I18N_DIR,
) -> str:
    env = os.environ if env is None else env
    config = config or {}
    preferred = flag if flag is not None else env.get("ALIA_LANG")
    if preferred is None:
        configured = config.get("lang")
        preferred = configured if isinstance(configured, str) else None
    normalized = normalize_language(preferred, i18n_dir)
    if normalized and normalized != "auto":
        return normalized
    for name in ("LC_ALL", "LC_MESSAGES", "LANG"):
        if env.get(name):
            locale_language = normalize_language(env[name], i18n_dir)
            return "en" if locale_language == "auto" else (locale_language or "en")
    return "en"


def set_language(language: str, i18n_dir: Path = I18N_DIR) -> None:
    global _LANGUAGE, _MESSAGES, _EN_MESSAGES
    _LANGUAGE = normalize_language(language, i18n_dir) or "en"
    if _LANGUAGE == "auto":
        _LANGUAGE = "en"
    _EN_MESSAGES = load_messages("en", i18n_dir)
    _MESSAGES = _EN_MESSAGES if _LANGUAGE == "en" else load_messages(_LANGUAGE, i18n_dir)


def tr(key: str, **values: Any) -> str:
    if not _EN_MESSAGES:
        set_language("en")
    template = _MESSAGES.get(key, _EN_MESSAGES.get(key, key))
    return template.format(**values)


def tr_for(language: str, key: str, **values: Any) -> str:
    normalized = normalize_language(language) or "en"
    english = load_messages("en")
    messages = english if normalized == "en" else load_messages(normalized)
    return messages.get(key, english.get(key, key)).format(**values)


def extract_language_flag(args: list[str]) -> tuple[str | None, list[str]]:
    remaining: list[str] = []
    language: str | None = None
    index = 0
    while index < len(args):
        item = args[index]
        if item == "--":
            remaining.extend(args[index:])
            break
        if item == "--lang":
            if index + 1 >= len(args):
                raise RuntimeError(tr("args.lang_value"))
            language = args[index + 1]
            index += 2
            continue
        if item.startswith("--lang="):
            language = item.split("=", 1)[1]
            index += 1
            continue
        remaining.append(item)
        index += 1
    return language, remaining



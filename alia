ENVIRONMENT_START = "<!-- alia:environment:start -->"
ENVIRONMENT_END = "<!-- alia:environment:end -->"


def environment_notes() -> list[str]:
    python = shutil.which("python")
    python3 = shutil.which("python3")
    notes = []
    if python is None and python3 is not None:
        notes.append("Use `python3`; there is no `python` command.")
    if shutil.which("pip") is None and python3 is not None:
        notes.append("Use `python3 -m pip`, not `pip`.")
    notes.extend([
        "Foreground shell commands time out after 120 s; run long jobs with a smaller input or in the background.",
        "Commands that need `sudo` cannot be answered interactively; tell the user to run them.",
        "You run on a local model with one inference slot: prefer few, targeted tool calls; read only the file parts you need (grep -n first).",
    ])
    return notes


def write_python_shim(qwen_home: Path) -> Path | None:
    """Link `python` to `python3` on hosts without `python`; models reach for `python` by habit."""
    shim_dir = qwen_home / "bin"
    shim = shim_dir / "python"
    python3 = shutil.which("python3")
    if shutil.which("python") is not None and not shim.is_symlink():
        return None
    if python3 is None:
        return None
    ensure_private_dir(shim_dir)
    if shim.is_symlink() or shim.exists():
        if shim.is_symlink() and os.readlink(shim) == python3:
            return shim
        shim.unlink()
    shim.symlink_to(python3)
    return shim


def write_environment_context(qwen_home: Path) -> Path:
    path = qwen_home / "QWEN.md"
    managed_content = "\n" + "\n".join(f"- {note}" for note in environment_notes()) + "\n"
    try:
        # Decode bytes directly so newline translation cannot alter user-owned text.
        current = path.read_bytes().decode("utf-8")
    except FileNotFoundError:
        updated = f"# Alia environment\n\n{ENVIRONMENT_START}{managed_content}{ENVIRONMENT_END}\n"
    else:
        start = current.find(ENVIRONMENT_START)
        end = current.find(ENVIRONMENT_END, start + len(ENVIRONMENT_START))
        if start >= 0 and end >= 0:
            content_start = start + len(ENVIRONMENT_START)
            updated = current[:content_start] + managed_content + current[end:]
        else:
            separator = "" if not current else ("\n" if current.endswith("\n") else "\n\n")
            updated = current + separator + ENVIRONMENT_START + managed_content + ENVIRONMENT_END + "\n"
    write_private_text(path, updated)
    return path


def generate_settings(

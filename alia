def ensure_private_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.chmod(0o700)


def write_private_text(path: Path, text: str, encoding: str = "utf-8") -> None:
    ensure_private_dir(path.parent)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    try:
        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(descriptor, "w", encoding=encoding) as handle:
            handle.write(text)
        os.replace(temporary, path)
        path.chmod(0o600)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def color(code: str, text: str, stream: Any = sys.stdout) -> str:
    if os.environ.get("NO_COLOR") is not None or not getattr(stream, "isatty", lambda: False)():
        return text
    return f"\033[{code}m{text}\033[0m"


def load_profiles(path: Path = PROFILES_FILE) -> list[dict[str, Any]]:
    with path.open(encoding="utf-8") as handle:
        value = json.load(handle)
    if not isinstance(value, list):
        raise ValueError(tr("error.profiles_not_list"))
    return value


def _run_text(args: list[str]) -> str:
    try:
        return subprocess.run(args, check=False, capture_output=True, text=True, timeout=4).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def mem_available_gb() -> float | None:
    try:
        for line in Path("/proc/meminfo").read_text(encoding="utf-8").splitlines():
            if line.startswith("MemAvailable:"):
                return int(line.split()[1]) / 1024 / 1024
    except (OSError, ValueError, IndexError):
        pass
    return None


def ram_warning(profile: dict[str, Any], available_gb: float | None) -> str | None:
    """Warn when an offloading profile would not keep its experts in RAM.

    Checked right before a new server starts: Ollama is unloaded and the model's own
    page-cache pages still count as available, so this is the RAM the server can keep.
    """
    needed = profile.get("ram_free_gb")
    if needed is None or available_gb is None or available_gb >= needed:
        return None
    warning = tr("startup.ram_warning", available=f"{available_gb:.1f}", needed=f"{needed:g}")
    if profile.get("id") != "rtx8gb-qwen35-9b-fast":
        warning += " " + tr("startup.ram_warning_lighter")
    return warning


def detect_hardware() -> dict[str, Any]:
    gpu_name: str | None = None
    gpu_index: int | None = None
    vram_gb = 0.0
    raw_gpu = _run_text([
        "nvidia-smi", "--query-gpu=index,name,memory.total", "--format=csv,noheader,nounits"
    ])
    if raw_gpu:
        # Select the NVIDIA GPU with the most VRAM when several are present.
        parsed: list[tuple[float, int, str]] = []
        for line in raw_gpu.splitlines():
            try:
                index, name, mib = line.split(",", 2)
                parsed.append((float(mib.strip()) / 1024, int(index.strip()), name.strip()))
            except ValueError:
                continue
        # Honor an inherited CUDA_VISIBLE_DEVICES allocation (e.g. from a scheduler):
        # nvidia-smi ignores it, so only consider the GPUs it lists by index.
        mask = os.environ.get("CUDA_VISIBLE_DEVICES")
        if mask is not None:
            allowed = [item.strip() for item in mask.split(",") if item.strip()]
            if all(item.isdigit() for item in allowed):
                parsed = [item for item in parsed if str(item[1]) in allowed]
        if parsed:
            vram_gb, gpu_index, gpu_name = max(parsed, key=lambda item: item[0])

    ram_gb = 0.0
    try:
        for line in Path("/proc/meminfo").read_text(encoding="utf-8").splitlines():
            if line.startswith("MemTotal:"):
                ram_gb = int(line.split()[1]) / 1024 / 1024
                break
    except (OSError, ValueError):
        pass

    cpu_name = tr("hardware.unknown")
    lscpu = _run_text(["lscpu"])
    for line in lscpu.splitlines():
        if line.lower().startswith(("model name:", "modellname:")):
            cpu_name = line.split(":", 1)[1].strip()
            break
    return {
        "gpu_name": gpu_name,
        "gpu_index": gpu_index,
        "vram_gb": round(vram_gb, 1),
        "ram_gb": round(ram_gb, 1),
        "cpu_name": cpu_name,
        "cpu_count": os.cpu_count() or 1,
    }


def profile_fits(profile: dict[str, Any], hw: dict[str, Any]) -> bool:
    match = profile.get("match", {})
    if not hw.get("gpu_name"):
        return False
    if hw.get("vram_gb", 0) < match.get("min_vram_gb", 0):
        return False
    if hw.get("ram_gb", 0) < match.get("min_ram_gb", 0):
        return False
    maximum = match.get("max_vram_gb")
    return maximum is None or hw.get("vram_gb", 0) <= maximum


def read_config(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    except (OSError, json.JSONDecodeError) as exc:
        raise RuntimeError(tr("config.unreadable", path=path, error=exc)) from exc
    if not isinstance(value, dict):
        raise RuntimeError(tr("config.not_object", path=path))
    return value


def write_config(path: Path, profile_id: str | None) -> None:
    ensure_private_dir(path.parent)
    data = read_config(path)
    if profile_id is None:
        data.pop("profile", None)
    else:
        data["profile"] = profile_id
    write_private_text(path, json.dumps(data, indent=2) + "\n")


def write_language_config(path: Path, language: str) -> None:
    ensure_private_dir(path.parent)
    data = read_config(path)
    data["lang"] = language
    write_private_text(path, json.dumps(data, indent=2) + "\n")


def choose_profile(
    profiles: list[dict[str, Any]], hw: dict[str, Any], pinned: str | None = None
) -> tuple[dict[str, Any] | None, str, bool]:
    if pinned:
        found = next((item for item in profiles if item["id"] == pinned), None)
        if not found:
            return None, tr("profile.pinned_missing", profile=pinned), False
        warning = not profile_fits(found, hw)
        reason = tr("profile.pinned")
        if warning:
            reason += "; " + tr("profile.outside_limits")
        return found, reason, warning

    fitting = [item for item in profiles if profile_fits(item, hw)]
    measured = [item for item in fitting if not item.get("unmeasured")]
    if measured:
        winner = max(measured, key=lambda item: item.get("rank", 0))
        return winner, tr("profile.best_measured"), False
    if fitting:
        winner = max(fitting, key=lambda item: item.get("rank", 0))
        return winner, tr("profile.only_unmeasured"), True
    if not hw.get("gpu_name"):
        return None, tr("profile.no_gpu"), True
    return None, tr("profile.no_match"), True


def model_file_complete(path: Path, expected_gb: float | int | None) -> bool:
    if not path.is_file():
        return False
    if not isinstance(expected_gb, (int, float)) or expected_gb <= 0:
        return True
    try:
        return path.stat().st_size >= float(expected_gb) * 1_000_000_000 * 0.95
    except OSError:
        return False


def find_model(profile: dict[str, Any], paths: dict[str, Path]) -> Path | None:
    model = profile["model"]
    candidates = [Path(os.path.expanduser(item)) for item in model["local_candidates"]]
    candidates.append(paths["models"] / model["hf_repo"].replace("/", "--") / model["file"])
    return next(
        (path for path in candidates if model_file_complete(path, model.get("size_gb"))),
        None,
    )


def download_command(profile: dict[str, Any], paths: dict[str, Path]) -> list[str]:
    model = profile["model"]
    target = paths["models"] / model["hf_repo"].replace("/", "--")
    return ["hf", "download", model["hf_repo"], model["file"], "--local-dir", str(target)]


def ensure_model(profile: dict[str, Any], paths: dict[str, Path]) -> Path | None:
    existing = find_model(profile, paths)
    if existing:
        return existing
    command = download_command(profile, paths)
    print(color("33", tr("model.missing")))
    print(tr("model.download_command"))
    print("  " + shlex.join(command))
    try:
        answer = input(tr("model.download_prompt")).strip().lower()
    except EOFError:
        answer = ""
    if answer not in {"y", "yes", "j", "ja"}:
        return None
    if shutil.which("hf") is None:
        raise RuntimeError(tr("model.hf_missing"))
    command[-1] = str(Path(command[-1]).expanduser())
    Path(command[-1]).mkdir(parents=True, exist_ok=True)
    result = subprocess.run(command, check=False)
    if result.returncode != 0:
        raise RuntimeError(tr("model.download_failed", code=result.returncode))
    return find_model(profile, paths)


def find_llama_server() -> tuple[Path | None, dict[str, str]]:
    def library_env(binary: Path) -> dict[str, str]:
        existing = os.environ.get("LD_LIBRARY_PATH")
        value = str(binary.parent) + (os.pathsep + existing if existing else "")
        return {"LD_LIBRARY_PATH": value}

    configured = os.environ.get("ALIA_LLAMA_SERVER")
    if configured:
        binary = Path(configured).expanduser()
        if binary.is_file() and os.access(binary, os.X_OK):
            return binary, library_env(binary)
    preferred = Path.home() / "src/llama.cpp/build/bin/llama-server"
    if preferred.is_file() and os.access(preferred, os.X_OK):
        return preferred, library_env(preferred)
    return None, {}


def build_server_args(binary: Path, profile: dict[str, Any], model_path: Path) -> list[str]:
    profile_args = [str(value) for value in profile["server_args"]]
    forbidden = {"--host", "--port", "-a"}
    if any(
        value in forbidden or value.startswith(("--host=", "--port=", "-a="))
        for value in profile_args
    ):
        raise RuntimeError(tr("server.profile_network_args"))
    return [
        str(binary), "-m", str(model_path), "-c", str(profile["ctx"]),
        *profile_args, "--no-webui", "--api-key", API_KEY,
        "--host", HOST, "--port", str(PORT), "--alias", profile["id"],
    ]


def health_ok(timeout: float = 0.7) -> bool:
    try:
        request = urllib.request.Request(
            f"http://{HOST}:{PORT}/health",
            headers={"Authorization": f"Bearer {API_KEY}"},
        )
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return response.status == 200
    except (OSError, urllib.error.URLError):
        return False


def process_start_ticks(pid: int) -> str | None:
    try:
        # starttime is field 22; splitting after ')' handles spaces in comm.
        fields = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8").rsplit(")", 1)[1].split()
        if fields[0] == "Z":
            return None
        return fields[19]
    except (OSError, IndexError):
        return None


def terminate_process(process: subprocess.Popen[bytes], timeout: float = 2) -> None:
    """Terminate and reap a child we own, escalating after a bounded wait."""
    if process.poll() is not None:
        process.wait()
        return
    try:
        process.terminate()
        process.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        process.kill()
        try:
            process.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            pass
    except OSError:
        pass


def read_pid(path: Path) -> int | None:
    try:
        pid = int(path.read_text(encoding="ascii").strip())
        return pid if pid > 1 else None
    except (OSError, ValueError):
        return None


def read_server_state(paths: dict[str, Path]) -> dict[str, Any]:
    try:
        return json.loads(paths["server_state"].read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}


def managed_pid(paths: dict[str, Path]) -> int | None:
    pid = read_pid(paths["pid"])
    if pid is None:
        return None
    state = read_server_state(paths)
    saved_ticks = state.get("start_ticks")
    if not saved_ticks or state.get("pid") != pid:
        return None
    current_ticks = process_start_ticks(pid)
    if current_ticks is None or str(saved_ticks) != current_ticks:
        return None
    return pid


def clear_server_files(paths: dict[str, Path], expected_pid: int | None = None) -> None:
    if expected_pid is not None and read_pid(paths["pid"]) not in (None, expected_pid):
        return
    for key in ("pid", "server_state"):
        try:
            paths[key].unlink()
        except FileNotFoundError:
            pass


def signal_managed_process(pid: int, expected_ticks: str, signum: int) -> bool:
    if process_start_ticks(pid) != expected_ticks:
        return False
    pidfd_open = getattr(os, "pidfd_open", None)
    pidfd_send_signal = getattr(signal, "pidfd_send_signal", None)
    if pidfd_open is not None and pidfd_send_signal is not None:
        descriptor = pidfd_open(pid)
        try:
            if process_start_ticks(pid) != expected_ticks:
                return False
            pidfd_send_signal(descriptor, signum)
        finally:
            os.close(descriptor)
    else:
        if process_start_ticks(pid) != expected_ticks:
            return False
        os.kill(pid, signum)
    return True


def wait_until_gone(pid: int, expected_ticks: str, seconds: float) -> bool:
    deadline = time.monotonic() + seconds
    while process_start_ticks(pid) == expected_ticks:
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.1)
    return True


def stop_server(
    paths: dict[str, Path], quiet: bool = False, wait_seconds: float = 5.0,
    kill_wait_seconds: float = 2.0,
) -> bool:
    pid = managed_pid(paths)
    if pid is None:
        clear_server_files(paths)
        if not quiet:
            print(tr("server.none"))
        return False
    expected_ticks = str(read_server_state(paths).get("start_ticks"))

    try:
        if not signal_managed_process(pid, expected_ticks, signal.SIGTERM):
            clear_server_files(paths, expected_pid=pid)
            return False
    except ProcessLookupError:
        clear_server_files(paths, expected_pid=pid)
        return False
    if not wait_until_gone(pid, expected_ticks, wait_seconds):
        try:
            signal_managed_process(pid, expected_ticks, signal.SIGKILL)
        except ProcessLookupError:
            pass
        if not wait_until_gone(pid, expected_ticks, kill_wait_seconds):
            if not quiet:
                print(tr("server.stop_failed", pid=pid), file=sys.stderr)
            return False
    clear_server_files(paths, expected_pid=pid)
    if not quiet:
        print(tr("server.stopped", pid=pid))
    return True


def ollama_loaded_models() -> list[dict[str, Any]] | None:
    try:
        with urllib.request.urlopen("http://127.0.0.1:11434/api/ps", timeout=1.0) as response:
            value = json.load(response).get("models", [])
            return value if isinstance(value, list) else []
    except (OSError, ValueError, urllib.error.URLError):
        return None


def unload_ollama() -> int:
    def unload(name: str) -> bool:
        payload = json.dumps({"model": name, "keep_alive": 0}).encode()
        request = urllib.request.Request(
            "http://127.0.0.1:11434/api/generate", data=payload,
            headers={"Content-Type": "application/json"}, method="POST",
        )
        try:
            with urllib.request.urlopen(request, timeout=3.0):
                return True
        except (OSError, urllib.error.URLError):
            return False

    models = ollama_loaded_models()
    if models is None:
        return 0
    unloaded = 0
    for item in models:
        name = item.get("name") or item.get("model")
        if name and unload(name):
            unloaded += 1
    if models:
        deadline = time.monotonic() + 10.0
        resend_at = time.monotonic() + 1.0
        while time.monotonic() < deadline:
            remaining = ollama_loaded_models()
            if remaining == []:
                return unloaded
            if remaining is None:
                break
            # A LAN client can reload a model meanwhile; repeat the unload at most once per second.
            if time.monotonic() >= resend_at:
                resend_at = time.monotonic() + 1.0
                for item in remaining:
                    name = item.get("name") or item.get("model")
                    if name and unload(name):
                        unloaded += 1
            time.sleep(0.25)
        raise RuntimeError(tr("ollama.unload_failed"))
    return unloaded


def process_owns_listen_port(pid: int, port: int) -> bool:
    socket_inodes: set[str] = set()
    for table in (Path("/proc/net/tcp"), Path("/proc/net/tcp6")):
        try:
            lines = table.read_text(encoding="ascii").splitlines()[1:]
        except OSError:
            continue
        for line in lines:
            fields = line.split()
            if len(fields) > 9 and fields[3] == "0A":
                try:
                    local_port = int(fields[1].rsplit(":", 1)[1], 16)
                except (ValueError, IndexError):
                    continue
                if local_port == port:
                    socket_inodes.add(fields[9])
    if not socket_inodes:
        return False
    try:
        return any(
            entry.is_symlink()
            and os.readlink(entry).removeprefix("socket:[").removesuffix("]") in socket_inodes
            for entry in Path(f"/proc/{pid}/fd").iterdir()
        )
    except OSError:
        return False


def server_state_matches_profile(
    state: dict[str, Any], profile: dict[str, Any], model_path: Path | None = None,
    binary: Path | None = None, gpu_index: int | None = None,
) -> bool:
    if state.get("profile") != profile["id"] or state.get("ctx") != profile["ctx"]:
        return False
    if model_path is None or binary is None:
        return True
    expected_argv = build_server_args(binary, profile, model_path)
    return (
        state.get("model_path") == str(model_path)
        and state.get("binary") == str(binary)
        and state.get("argv") == expected_argv
        and state.get("port") == PORT
        and state.get("gpu_index") == gpu_index
    )


def start_server(
    profile: dict[str, Any], model_path: Path, paths: dict[str, Path], gpu_index: int | None = None,
) -> tuple[int, bool, subprocess.Popen[bytes] | None]:
    binary, env_extra = find_llama_server()
    if binary is None:
        raise RuntimeError(tr("server.binary_missing"))
    args = build_server_args(binary, profile, model_path)
    pid = managed_pid(paths)
    state = read_server_state(paths)
    if (
        pid and server_state_matches_profile(state, profile, model_path, binary, gpu_index)
        and process_owns_listen_port(pid, PORT) and health_ok()
    ):
        return pid, True, None
    if pid:
        if not stop_server(paths, quiet=True):
            raise RuntimeError(tr("server.stop_failed", pid=pid))
    elif paths["pid"].exists():
        clear_server_files(paths)
    if health_ok():
        raise RuntimeError(tr("server.port_foreign", port=PORT))

    unload_ollama()
    ram_note = ram_warning(profile, mem_available_gb())
    if ram_note:
        print(color("33", ram_note))
    ensure_private_dir(paths["state"])
    env = os.environ.copy()
    env.update(env_extra)
    # Pin the server to the detected GPU unless the caller already restricted the
    # visible devices; an inherited allocation is never widened or replaced.
    if gpu_index is not None and "CUDA_VISIBLE_DEVICES" not in os.environ:
        env["CUDA_VISIBLE_DEVICES"] = str(gpu_index)
    process: subprocess.Popen[bytes] | None = None
    try:
        descriptor = os.open(paths["log"], os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(descriptor, "ab", buffering=0) as log:
            process = subprocess.Popen(
                args, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
                env=env, start_new_session=True,
            )
        start_ticks = process_start_ticks(process.pid)
        if start_ticks is None:
            if process.poll() is None:
                raise RuntimeError(tr("server.start_time_failed"))
            process.wait()
            raise RuntimeError(tr("server.exited", log=paths["log"]))
        state = {
            "pid": process.pid,
            "start_ticks": start_ticks,
            "profile": profile["id"],
            "ctx": profile["ctx"],
            "gpu_index": gpu_index,
            "model": profile["model"]["file"],
            "model_path": str(model_path),
            "port": PORT,
            "binary": str(binary),
            "argv": args,
            "started_at": int(time.time()),
        }
        write_private_text(paths["server_state"], json.dumps(state, indent=2) + "\n")
        pid_descriptor = os.open(paths["pid"], os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(pid_descriptor, "w", encoding="ascii") as handle:
            handle.write(f"{process.pid}\n")
    except BaseException:
        if process is not None:
            terminate_process(process)
            clear_server_files(paths, expected_pid=process.pid)
        raise
    assert process is not None
    return process.pid, False, process


def resolve_gpu_lock(
    config: dict[str, Any], env: dict[str, str] | None = None,
) -> Path | None:
    """Resolve the optional start-sequence lock, with the environment winning."""
    env = os.environ if env is None else env
    value: Any = env.get("ALIA_GPU_LOCK", config.get("gpu_lock"))
    if value in (None, ""):
        return None
    if not isinstance(value, str):
        raise RuntimeError(tr("gpu_lock.invalid_config"))
    return Path(os.path.expandvars(value)).expanduser()


class GpuStartLock:
    """Non-blocking flock with a bounded wait; release explicitly after startup."""

    def __init__(self, path: Path | None, wait_seconds: float = 0) -> None:
        self.path = path
        self.wait_seconds = wait_seconds
        self.handle: Any = None

    def __enter__(self) -> GpuStartLock:
        if self.path is None:
            return self
        try:
            self.path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            descriptor = os.open(self.path, os.O_RDWR | os.O_CREAT, 0o600)
            os.fchmod(descriptor, 0o600)
            self.handle = os.fdopen(descriptor, "a+", encoding="utf-8")
        except OSError as exc:
            raise RuntimeError(tr("gpu_lock.open_failed", path=self.path, error=exc)) from exc
        deadline = time.monotonic() + self.wait_seconds
        announced = False
        while True:
            try:
                fcntl.flock(self.handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                self.handle.seek(0)
                self.handle.truncate()
                self.handle.write(f"alia pid={os.getpid()}\n")
                self.handle.flush()
                return self
            except BlockingIOError as exc:
                if not announced:
                    print(tr("gpu_lock.busy", path=self.path))
                    announced = True
                if time.monotonic() >= deadline:
                    self.handle.close()
                    self.handle = None
                    raise RuntimeError(tr(
                        "gpu_lock.timeout", path=self.path, seconds=self.wait_seconds,
                    )) from exc
                time.sleep(min(0.1, max(0.0, deadline - time.monotonic())))

    def __exit__(self, *_: Any) -> None:
        if self.handle is not None:
            fcntl.flock(self.handle.fileno(), fcntl.LOCK_UN)
            self.handle.close()
            self.handle = None


def load_bar(elapsed: float, expected: float | None = None) -> str:
    seconds_per_cell = expected / 10 if expected and expected > 0 else 3
    count = min(10, max(0, int(elapsed / seconds_per_cell)))
    return "█" * count + "░" * (10 - count)


def wait_for_health(
    pid: int, paths: dict[str, Path], timeout: float = 300.0,
    process: subprocess.Popen[bytes] | None = None,
    profile_id: str | None = None,
) -> None:
    started = time.monotonic()
    expected: float | None = None
    load_path = paths["state"] / "last-load.json"
    try:
        previous = json.loads(load_path.read_text(encoding="utf-8"))
        if previous.get("profile") == profile_id and float(previous.get("seconds", 0)) > 0:
            expected = float(previous["seconds"])
    except (OSError, ValueError, TypeError, json.JSONDecodeError):
        pass
    frames = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    index = 0
    interactive = sys.stdout.isatty()
    last_plain_second = -1
    try:
        while time.monotonic() - started < timeout:
            elapsed = int(time.monotonic() - started)
            if process is not None and process.poll() is not None:
                process.wait()
                clear_server_files(paths, expected_pid=pid)
                raise RuntimeError(tr("server.exited", log=paths["log"]))
            if health_ok():
                measured = max(0.1, round(time.monotonic() - started, 1))
                if profile_id:
                    try:
                        write_private_text(
                            load_path,
                            json.dumps({"profile": profile_id, "seconds": measured}) + "\n",
                        )
                    except OSError:
                        pass  # only feeds the progress bar; never block a healthy start
                if interactive:
                    print(f"\r{color('32', '✓')} {tr('server.ready_tty', seconds=elapsed)}" + " " * 15)
                else:
                    print(tr("server.ready", seconds=elapsed))
                return
            if process_start_ticks(pid) is None:
                if process is not None:
                    process.poll()
                clear_server_files(paths, expected_pid=pid)
                raise RuntimeError(tr("server.exited", log=paths["log"]))
            if interactive:
                bar = load_bar(elapsed, expected)
                key = "server.loading_expected" if expected is not None else "server.loading"
                values = {"bar": bar, "seconds": elapsed, "expected": round(expected or 0)}
                print(f"\r{frames[index % len(frames)]} {tr(key, **values)}", end="", flush=True)
                index += 1
            elif elapsed and elapsed % 10 == 0 and elapsed != last_plain_second:
                print(tr("server.loading_plain", seconds=elapsed))
                last_plain_second = elapsed
            time.sleep(0.5)
    except KeyboardInterrupt:
        if process is not None and process.poll() is None:
            terminate_process(process)
            clear_server_files(paths, expected_pid=pid)
        else:
            stop_server(paths, quiet=True)
        raise
    if interactive:
        print()
    if process is not None and process.poll() is None:
        terminate_process(process)
        clear_server_files(paths, expected_pid=pid)
    else:
        stop_server(paths, quiet=True)
    raise RuntimeError(tr("server.timeout", seconds=int(timeout), log=paths["log"]))


